{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VyaparPro",
  "version": "0.1.0",
  "identifier": "com.vyaparpro.app",
  "build": {
    "frontendDist": "../frontend_html"
  },
  "app": {
        "windows": [
      {
        "title": "VyaparPro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
                  "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["binaries/vyaparpro-backend"]
  }
}
