{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    { "identifier": "shell:allow-spawn", "allow": [{ "name": "binaries/vyaparpro-backend", "sidecar": true }] },
    { "identifier": "shell:allow-kill", "allow": [{ "name": "binaries/vyaparpro-backend", "sidecar": true }] }
  ]
}
